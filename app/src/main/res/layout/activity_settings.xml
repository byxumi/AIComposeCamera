<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 构图相机"
                android:textColor="@color/neo_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="版本 1.0.0 · 本地离线构图引擎"
                android:textColor="@color/neo_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="构图辅助"
                android:textColor="@color/neo_hint"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 自动快门 -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoShutterSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="自动快门"
                android:textColor="@color/neo_text_primary"
                app:useMaterialThemeColors="false"
                app:thumbTint="@color/neo_accent"
                app:trackTint="@color/neo_accent_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:text="构图达到高分并稳定时自动拍摄"
                android:textColor="@color/neo_text_secondary"
                android:textSize="12sp" />

            <!-- 灵敏度 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="自动快门灵敏度"
                android:textColor="@color/neo_text_primary"
                android:textSize="14sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensitivitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="2"
                android:stepSize="1"
                android:value="1"
                app:thumbColor="@color/neo_accent"
                app:trackColorActive="@color/neo_accent"
                app:trackColorInactive="@color/neo_accent_dim" />

            <TextView
                android:id="@+id/sensitivityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中"
                android:textColor="@color/neo_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/neo_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="显示"
                android:textColor="@color/neo_hint"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/gridSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="构图网格"
                android:textColor="@color/neo_text_primary"
                app:useMaterialThemeColors="false"
                app:thumbTint="@color/neo_accent"
                app:trackTint="@color/neo_accent_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网格样式：三分法 / 黄金分割（长按预览切换）"
                android:textColor="@color/neo_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/faceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="人脸检测（人像优先）"
                android:textColor="@color/neo_text_primary"
                app:useMaterialThemeColors="false"
                app:thumbTint="@color/neo_accent"
                app:trackTint="@color/neo_accent_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开启后在无主体时也能识别人物位置"
                android:textColor="@color/neo_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/neo_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="关于"
                android:textColor="@color/neo_hint"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="本应用使用 CameraX + ML Kit 端侧检测 + 本地构图规则引擎，无需联网。\n\n参考：ai-composition-assistant (GitHub)"
                android:textColor="@color/neo_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>